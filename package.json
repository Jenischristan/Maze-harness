{
  "name": "dream-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Dream-RSI-style recursive exploration-policy improvement harness with a coding-agent CLI, tool calling, compaction, permissions, and sessions.",
  "bin": {
    "dream-harness": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts chat",
    "chat": "tsx src/cli.ts chat",
    "build": "tsc --noEmit && esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
